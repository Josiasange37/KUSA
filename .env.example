# URL publique du site (liens de confirmation d'email)
NEXT_PUBLIC_SITE_URL=https://kusa-five.vercel.app

# Supabase Auth — création de compte email + mot de passe
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Formulaire « Contacter le service » — envoi via Resend (https://resend.com)
RESEND_API_KEY=re_...
# Expéditeur : un domaine vérifié dans Resend (ex. site@kusa.cm)
CONTACT_FROM=KUSA <site@kusa.cm>
# Destinataire des demandes
CONTACT_TO=contact@kusa.cm
